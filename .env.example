# OpenAI-compatible chat completions endpoint
# Leave AI_API_KEY empty to use the built-in heuristic analyzer (no key required)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Where the SQLite database lives. Defaults to ./.data, falling back to the
# system temp dir on read-only hosts such as Vercel. Point it at a durable
# volume to keep accounts and workspace sync working.
FIT_DATA_DIR=

# Set to 1 to allow accounts on temporary storage anyway. Anything written
# there is lost whenever the host restarts, so it stays off by default.
FIT_ALLOW_EPHEMERAL_STORAGE=
