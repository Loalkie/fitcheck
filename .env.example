# OpenAI-compatible chat completions endpoint
# Leave AI_API_KEY empty to use the built-in heuristic analyzer (no key required)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Where the SQLite database lives. Defaults to ./.data, falling back to the
# system temp dir on read-only hosts such as Vercel. Point it at a durable
# volume to keep accounts and workspace sync working.
FIT_DATA_DIR=

# Optional hosted Postgres for accounts and workspace sync: Vercel Postgres,
# Neon, Supabase or any Postgres server. POSTGRES_URL / POSTGRES_PRISMA_URL /
# POSTGRES_URL_NON_POOLING are picked up too, which is what the Vercel
# integrations inject. Tables are created on first use.
DATABASE_URL=

# Set to 1 to allow accounts on temporary storage anyway. Anything written
# there is lost whenever the host restarts, so it stays off by default.
FIT_ALLOW_EPHEMERAL_STORAGE=

# Comma-separated owner accounts. Only these can read or change the site-wide
# integration keys (AI provider, Stripe, job feeds) from the Settings page.
# Leave it empty and nobody can — the keys then come from the environment only.
ADMIN_EMAILS=

# Outbound job-board fetches verify TLS certificates. Set to 1 only on a machine
# whose CA store cannot validate a board; it disables that check.
FIT_INSECURE_FETCH=
