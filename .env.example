# OpenAI-compatible chat completions endpoint. This key also drives the AI
# Resume Studio: without it those endpoints return the built-in draft instead of
# a rewritten resume, and the draft says so.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1
# The resume writer is the most quality-sensitive call in the app. Anything in
# the gpt-4o / claude-3.5-sonnet / deepseek-chat class and above writes a usable
# resume; a reasoning model (deepseek-reasoner, o4-mini) writes a better one.
AI_MODEL=gpt-4o-mini

# Where the SQLite database lives. Defaults to ./.data, falling back to the
# system temp dir on read-only hosts such as Vercel. Point it at a durable
# volume to keep accounts and workspace sync working.
FIT_DATA_DIR=

# Optional hosted Postgres for accounts and workspace sync: Vercel Postgres,
# Neon, Supabase or any Postgres server. POSTGRES_URL / POSTGRES_PRISMA_URL /
# POSTGRES_URL_NON_POOLING are picked up too, which is what the Vercel
# integrations inject. Tables are created on first use.
DATABASE_URL=

# Set to 1 to allow accounts on temporary storage anyway. Anything written
# there is lost whenever the host restarts, so it stays off by default.
FIT_ALLOW_EPHEMERAL_STORAGE=

# Comma-separated owner accounts. Only these can read or change the site-wide
# integration keys (AI provider, Stripe, job feeds) from the Settings page.
# Leave it empty and nobody can — the keys then come from the environment only.
ADMIN_EMAILS=

# Outbound job-board fetches verify TLS certificates. Set to 1 only on a machine
# whose CA store cannot validate a board; it disables that check.
FIT_INSECURE_FETCH=

# Public origin used in password-reset and verification links, robots.txt and
# sitemap.xml. Set it when the host the request arrives on is not the address
# users should see (for example a custom domain in front of *.vercel.app).
APP_ORIGIN=

# Address published on /privacy and /terms for privacy, refund and support mail.
SUPPORT_EMAIL=

# Transactional email over an HTTP API — Resend by default, and Postmark,
# SendGrid and Mailgun accept the same body. Password reset and email
# verification answer 503 without it instead of pretending to send.
MAIL_API_KEY=
MAIL_API_URL=
MAIL_FROM=
